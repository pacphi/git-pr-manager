{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Managed from pacphi/mise-dotfiles. Replaces Dependabot version updates (2026-10-21).",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ]
  },
  "packageRules": [
    {
      "description": "gomod: dev commit prefix",
      "matchCategories": [
        "golang"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "commitMessagePrefix": "chore:"
    },
    {
      "description": "gomod: settings",
      "matchCategories": [
        "golang"
      ],
      "schedule": [
        "* 0-5 * * 1"
      ],
      "labels": [
        "dependencies",
        "go"
      ],
      "commitMessagePrefix": "chore:"
    },
    {
      "description": "gomod: group go-minor-patch",
      "matchCategories": [
        "golang"
      ],
      "groupName": "go-minor-patch",
      "matchPackageNames": [
        "*"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "description": "github-actions: dev commit prefix",
      "matchCategories": [
        "ci"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "commitMessagePrefix": "ci:"
    },
    {
      "description": "github-actions: settings",
      "matchCategories": [
        "ci"
      ],
      "schedule": [
        "* 0-5 * * 1"
      ],
      "labels": [
        "dependencies",
        "github-actions"
      ],
      "commitMessagePrefix": "ci:"
    },
    {
      "description": "github-actions: group github-actions",
      "matchCategories": [
        "ci"
      ],
      "groupName": "github-actions",
      "matchPackageNames": [
        "*"
      ]
    }
  ],
  "prConcurrentLimit": 15
}
